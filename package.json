{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "string-singer",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#internal/*": "./*"
  },
  "exports": {
    ".": "./index.ts",
    "./node": "./runtimes/node.ts",
    "./deno": "./runtimes/deno.ts",
    "./bun": "./runtimes/bun.ts",
    "./browser": "./runtimes/browser.ts"
  },
  "scripts": {
